{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do servi\u00e7o"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o de venda do servi\u00e7o"
    },
    "duration": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em minutos"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do servi\u00e7o"
    },
    "products_used": {
      "type": "array",
      "description": "Produtos utilizados no servi\u00e7o",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "manicure",
        "pedicure",
        "nail_art",
        "manutencao",
        "outros"
      ],
      "description": "Categoria do servi\u00e7o"
    },
    "color": {
      "type": "string",
      "description": "Cor associada ao servi\u00e7o para identifica\u00e7\u00e3o visual"
    },
    "commission": {
      "type": "number",
      "description": "Percentual de comiss\u00e3o do servi\u00e7o"
    },
    "slug": {
      "type": "string",
      "description": "URL amig\u00e1vel gerada automaticamente"
    }
  },
  "required": [
    "name",
    "price",
    "duration"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}